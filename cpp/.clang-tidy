# clang-tidy config — the C++ face and its suites. The C core carries its own .clang-tidy under core/;
# clang-tidy reads the nearest one. HeaderFilterRegex below names cpp/ only, so a C header a C++ unit
# includes is never reported, and never fixed, under C++ flags (it is swept through a C unit).
# WarningsAsErrors is empty: the build's -Werror governs failure; clang-tidy reports.
#
# Disabled-check rationale, one line each:
#   -bugprone-easily-swappable-parameters: adjacent same-type parameters are already a struct by house rule.
#   -bugprone-exception-escape: the face is noexcept by design; an allocation failure aborts, the documented policy.
#   -misc-non-private-member-variables-in-classes: the options structs are public-data aggregates by design.
#   -misc-include-cleaner: clangd provides the include feedback in the editor.
#   -misc-override-with-different-visibility: conflicts with the GoogleTest fixture idiom.
#   -misc-no-recursion: the face holds no walk; the core's set keeps it on.
#   -modernize-use-trailing-return-type: the house writes trailing returns; the check is redundant with -Wall noise.
#   -performance-enum-size: the enum widths pin the ABI; a narrower width is wrong here.
#   -portability-avoid-pragma-once: conflicts with the #pragma once house rule.
#   -readability-identifier-length: the house names in full; a short name is a review finding, not a lint one.
#   -readability-magic-numbers: layout pins and ABI widths are literals by design.
#   -readability-function-cognitive-complexity: raw thresholds are not a useful complexity measure.
#   -readability-named-parameter: an unnamed parameter documents an intentionally unused override.
#   -readability-uppercase-literal-suffix: the literal spelling follows .clang-format, not this check.

Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  concurrency-*,
  clang-analyzer-*,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-prefer-member-initializer,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-pro-type-static-cast-downcast,
  cppcoreguidelines-slicing,
  cppcoreguidelines-special-member-functions,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  -misc-override-with-different-visibility,
  -misc-no-recursion,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  -performance-enum-size,
  portability-*,
  -portability-avoid-pragma-once,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-function-cognitive-complexity,
  -readability-named-parameter,
  -readability-uppercase-literal-suffix

WarningsAsErrors: ''
HeaderFilterRegex: '(^|.*/)cpp/(include|src|tests)/.*\.hpp$'
FormatStyle: none

CheckOptions:
  - { key: readability-identifier-naming.NamespaceCase,           value: lower_case }
  - { key: readability-identifier-naming.FunctionCase,            value: lower_case }
  - { key: readability-identifier-naming.VariableCase,            value: lower_case }
  - { key: readability-identifier-naming.ParameterCase,           value: lower_case }
  - { key: readability-identifier-naming.MemberCase,              value: lower_case }
  - { key: readability-identifier-naming.PrivateMemberSuffix,     value: _ }
  - { key: readability-identifier-naming.ProtectedMemberSuffix,   value: _ }
  - { key: readability-identifier-naming.ClassCase,               value: CamelCase }
  - { key: readability-identifier-naming.StructCase,              value: CamelCase }
  - { key: readability-identifier-naming.TypeAliasCase,           value: CamelCase }
  - { key: readability-identifier-naming.TypedefCase,             value: CamelCase }
  - { key: readability-identifier-naming.EnumCase,                value: CamelCase }
  - { key: readability-identifier-naming.EnumConstantCase,        value: lower_case }
  - { key: readability-identifier-naming.ConceptCase,             value: CamelCase }
  - { key: readability-identifier-naming.TemplateParameterCase,   value: CamelCase }
  - { key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor, value: true }
  - { key: cppcoreguidelines-special-member-functions.AllowMissingMoveFunctions, value: false }
  - { key: modernize-use-default-member-init.UseAssignment, value: false }
  - { key: modernize-use-emplace.IgnoreImplicitConstructors, value: true }
  - { key: performance-unnecessary-value-param.AllowedTypes, value: 'std::source_location' }
  - { key: performance-move-const-arg.CheckTriviallyCopyableMove, value: false }
