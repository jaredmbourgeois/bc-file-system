{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "debug",
            "inherits": "base",
            "displayName": "Debug, with the tests",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BC_FILE_SYSTEM_BUILD_POSTURE": "none"
            }
        },
        {
            "name": "hardened",
            "inherits": "base",
            "displayName": "RelWithDebInfo + hardening (the production posture)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "BC_FILE_SYSTEM_BUILD_POSTURE": "hardened"
            }
        },
        {
            "name": "sanitized",
            "inherits": "base",
            "displayName": "Debug + ASan/UBSan (the CI posture)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BC_FILE_SYSTEM_BUILD_POSTURE": "sanitized"
            }
        },
        {
            "name": "fuzz",
            "inherits": "base",
            "displayName": "Debug + ASan/UBSan + the libFuzzer targets (clang with libFuzzer only: Homebrew LLVM on a Mac)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BC_FILE_SYSTEM_BUILD_POSTURE": "sanitized",
                "BC_FILE_SYSTEM_BUILD_FUZZERS": "ON",
                "BUILD_TESTING": "OFF"
            }
        },
        {
            "name": "android",
            "hidden": true,
            "inherits": "base",
            "toolchainFile": "$env{ANDROID_HOME}/ndk/30.0.16248370/build/cmake/android.toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "BC_FILE_SYSTEM_BUILD_POSTURE": "hardened",
                "BUILD_TESTING": "ON",
                "BC_FILE_SYSTEM_DEVICE_TEST_ROOT": {
                    "type": "STRING",
                    "value": "/data/local/tmp/bc-file-system"
                }
            }
        },
        {
            "name": "android-arm64-api30",
            "inherits": "android",
            "displayName": "Android arm64-v8a, API 30 (the floor), hardened, with the tests (run on an emulator by scripts/android_legs.sh)",
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-30"
            }
        },
        {
            "name": "android-arm64-api33",
            "inherits": "android",
            "displayName": "Android arm64-v8a, API 33, hardened, with the tests (run on an emulator by scripts/android_legs.sh)",
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-33"
            }
        },
        {
            "name": "android-arm64-api35",
            "inherits": "android",
            "displayName": "Android arm64-v8a, API 35, hardened, with the tests (run on an emulator by scripts/android_legs.sh)",
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-35"
            }
        },
        {
            "name": "android-x86_64-api30",
            "inherits": "android",
            "displayName": "Android x86_64, API 30 (the floor), hardened, with the tests (compiled only: no x86_64 image is run)",
            "cacheVariables": {
                "ANDROID_ABI": "x86_64",
                "ANDROID_PLATFORM": "android-30"
            }
        },
        {
            "name": "bench",
            "inherits": "base",
            "displayName": "Release, no posture + the hand-run benchmark against std (what a consumer's release build compiles)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BC_FILE_SYSTEM_BUILD_POSTURE": "none",
                "BC_FILE_SYSTEM_BUILD_BENCHMARKS": "ON",
                "BUILD_TESTING": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "hardened",
            "configurePreset": "hardened"
        },
        {
            "name": "sanitized",
            "configurePreset": "sanitized"
        },
        {
            "name": "header-four-ways",
            "displayName": "The public header compiled four ways, and nothing else",
            "configurePreset": "debug",
            "targets": [
                "bc_file_system_core_header_c11",
                "bc_file_system_core_header_gnu11",
                "bc_file_system_core_header_cxx20",
                "bc_file_system_core_header_cxx23"
            ]
        },
        {
            "name": "path-freestanding",
            "displayName": "The path module as a freestanding object on the host compiler (the wasm32 object is built by verify.sh when the compiler has the target)",
            "configurePreset": "debug",
            "targets": [
                "bc_file_system_path_freestanding_host"
            ]
        },
        {
            "name": "fuzz",
            "configurePreset": "fuzz"
        },
        {
            "name": "bench",
            "configurePreset": "bench"
        },
        {
            "name": "android-arm64-api30",
            "configurePreset": "android-arm64-api30"
        },
        {
            "name": "android-arm64-api33",
            "configurePreset": "android-arm64-api33"
        },
        {
            "name": "android-arm64-api35",
            "configurePreset": "android-arm64-api35"
        },
        {
            "name": "android-x86_64-api30",
            "configurePreset": "android-x86_64-api30"
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "hardened",
            "configurePreset": "hardened",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "sanitized",
            "configurePreset": "sanitized",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
